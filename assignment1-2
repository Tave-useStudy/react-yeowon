import { useState } from 'react';

# 할일을 입력하는 파트
function TextInput({ onAdd }) {
  const [text, setText] = useState('');
# 조건 중 하나인 20자를 넘으면 안된다에 해당하는 코드이다
  const isOverLimit = text.length > 20;
  const isDisabled = text.trim() === '' || isOverLimit;

  const handleSubmit = () => {
    if (isDisabled) return;
    onAdd(text);
    setText('');
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter') {
      handleSubmit();
    }
  };

  return (
    <div>
      <input
        type="text"
        value={text}
        onChange={(e) => setText(e.target.value)}
        onKeyDown={handleKeyDown}
        placeholder="할 일을 입력하세요"
      />
      <button onClick={handleSubmit} disabled={isDisabled}>
        추가
      </button>

      <div>{text.length} / 20자</div>
      {isOverLimit && <p style={{ color: 'red' }}>20자를 초과할 수 없습니다.</p>}
    </div>
  );
}

export default TextInput;

# 랜덤 유저를 불러오는 코드
import { useState, useEffect } from 'react';

function UserProfile() {
  const [user, setUser] = useState(null);

  const fetchUser = async () => {
    const response = await fetch('https://randomuser.me/api/');
    const data = await response.json();
    setUser(data.results[0]);
  };

  useEffect(() => {
    fetchUser();
  }, []);

  if (!user) return <p>유저 정보를 불러오는 중</p>;

  return (
    <div>
      <h3>랜덤 유저 프로필</h3>
      <img src={user.picture.thumbnail} alt="profile" />
      <p>이름: {user.name.first} {user.name.last}</p>
      <p>이메일: {user.email}</p>
      <button onClick={fetchUser}>새로고침</button>
    </div>
  );
}

export default UserProfile;
